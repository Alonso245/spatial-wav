@namespace AtmosWeb
@inject IJSRuntime JS
@implements IDisposable

<header>
    <a class="brand" href="./"><span class="mark" aria-hidden="true"><i></i><i></i><i></i><i></i></span> spatial <span class="brand-divider">/</span> wav</a>
    <div class="header-controls">
        <span class="local-label"><span class="dot"></span> @T("En tu dispositivo", "On your device")</span>
        <nav class="language-switch" aria-label="@T("Idioma", "Language")">
            <button type="button" @onclick="UseSpanish" aria-pressed="@(language == "es" ? "true" : "false")" aria-label="Español">ES</button>
            <button type="button" @onclick="UseEnglish" aria-pressed="@(language == "en" ? "true" : "false")" aria-label="English">EN</button>
        </nav>
    </div>
</header>
<main>
    <p class="eyebrow">@T("UN POCO MÁS DE ESPACIO PARA TU AUDIO", "A LITTLE MORE ROOM FOR YOUR AUDIO")</p>
    <h1>@T("Sonido que", "Sound that")<br /><span>@T("encuentra su lugar.", "finds its place.")</span></h1>
    <p class="intro">@T("De E-AC-3/JOC a WAV 9.1.6, directamente en tu navegador.", "From E-AC-3/JOC to 9.1.6 WAV, right in your browser.")<br />@T("Sin instalaciones. Tu archivo se queda contigo.", "No installs. Your file stays with you.")</p>
    <section class="panel" aria-labelledby="workspace-title">
        <div class="panel-head"><h2 id="workspace-title">@(SingleReady ? T("Tu WAV está listo", "Your WAV is ready") : jobs.Count > 1 ? T("Tus archivos", "Your files") : T("Tu archivo", "Your file"))</h2>
            @if (jobs.Count > 0) {
                <div class="queue-tools"><button class="new-conversion" disabled="@(QueueLocked)" @onclick="PickFiles">@T("Añadir archivos", "Add files")</button><button class="new-conversion" disabled="@(QueueLocked)" @onclick="NewConversion"><span aria-hidden="true">＋</span> @T("Nueva conversión", "New conversion")</button></div>
            } else {
                <span class="tag"><span class="dot"></span>@(ready ? T("Listo en tu dispositivo", "Ready on your device") : T("Comprobando navegador…", "Checking your browser…"))</span>
            }
        </div>
        <input type="file" id="audio-file" accept=".ec3,.eac3,.m4a,.mp4" multiple disabled="@(!ready || QueueLocked)" aria-label="@T("Seleccionar archivos de audio", "Select audio files")" />
        @if (!AllReady) {
        <label class="drop" for="audio-file"><span class="upload" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 16V4m-4 4 4-4 4 4M4 15v4a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1v-4" /></svg></span><strong>@(jobs.Count == 1 ? jobs[0].Name : jobs.Count > 1 ? T($"{jobs.Count} archivos en la cola", $"{jobs.Count} files in the queue") : T("Elige o arrastra tus archivos", "Choose or drop your files"))</strong><span>@(jobs.Count == 0 ? T("Buscar en tu dispositivo", "Browse your device") : T("Añadir más archivos", "Add more files"))</span><small>@T("EC3, EAC3, M4A o MP4 · Hasta 128 MiB por archivo", "EC3, EAC3, M4A or MP4 · Up to 128 MiB per file")</small></label>
        }
        @if (jobs.Count > 1) {
            <details class="queue-disclosure" open><summary class="queue-heading"><span>@T("Cola de conversión", "Conversion queue")</span><span>@T($"{jobs.Count(x => x.State == JobState.Ready)} de {jobs.Count} listos", $"{jobs.Count(x => x.State == JobState.Ready)} of {jobs.Count} ready") <span class="queue-chevron" aria-hidden="true">⌄</span></span></summary>
            <ol class="file-queue">
                @foreach (var job in jobs) {
                    <li @key="job.Id" data-job-id="@job.Id" data-state="@job.State.ToString().ToLowerInvariant()">
                        <div class="queue-row"><span class="queue-symbol" aria-hidden="true">@if (job.State is JobState.Reading or JobState.Rendering or JobState.Finalizing) { <span class="spinner"></span> } else { @(job.State == JobState.Ready ? "✓" : job.State == JobState.Failed ? "!" : "·") }</span><div class="queue-file"><strong>@job.Name</strong><small>@($"{job.Size / 1048576d:F1} MiB") · @JobStatus(job)</small></div><button class="remove-file" disabled="@(QueueLocked)" @onclick="() => Remove(job)" aria-label="@T($"Quitar {job.Name}", $"Remove {job.Name}")">×</button></div>
                        @if (job.State == JobState.Failed) { <p class="queue-error">@ErrorMessage(job.Error)</p> }
                        @if (job.CanRetry && (job.State is JobState.Failed or JobState.Cancelled)) {
                            <button class="retry-file" disabled="@QueueLocked" @onclick="() => Retry(job)" aria-label="@T($"Reintentar {job.Name}", $"Retry {job.Name}")"><span aria-hidden="true">↻</span> @T("Reintentar", "Retry")</button>
                        }
                        @if (job.State == JobState.Ready) { <ConversionResult Job="job" Compact="true" Language="@language" Preparing="@(preparingJobId == job.Id)" DownloadBusy="UiLocked" Download="Download" DownloadMap="DownloadLayout" /> }
                    </li>
                }
            </ol></details>
        }
        @if (!AllReady) {
        <div class="settings"><div><small>@T("Distribución de salida", "Output layout")</small><strong>9.1.6 <span>· @T("16 canales", "16 channels")</span></strong></div><div><small>@T("Formato de audio", "Audio format")</small><strong>WAV <span>· @Format(new(bitDepth, outputRate))</span></strong></div></div>
        <details class="export-options">
            <summary><span>@T("Ajustes de exportación", "Export settings")</span><span class="export-summary">@Format(new(bitDepth, outputRate)) <span class="settings-chevron" aria-hidden="true">⌄</span></span></summary>
            <div class="export-body">
                <div class="export-fields">
                    <label for="bit-depth">@T("Profundidad de bits", "Bit depth")<select id="bit-depth" @bind="bitDepth" @bind:after="SaveExportSettings" disabled="@(QueueLocked)" aria-describedby="export-help"><option value="32">32-bit float</option><option value="16">16-bit PCM</option></select></label>
                    <label for="sample-rate">@T("Frecuencia de muestreo", "Sample rate")<select id="sample-rate" @bind="outputRate" @bind:after="SaveExportSettings" disabled="@(QueueLocked)" aria-describedby="export-help"><option value="44100">44.1 kHz</option><option value="48000">48 kHz</option><option value="96000">96 kHz</option></select></label>
                </div>
                <p id="export-help" class="export-help">@T("16 bits reduce el tamaño y la precisión; incluye dithering. Una frecuencia mayor no añade detalle al original.", "16-bit reduces size and precision; dithering is included. A higher sample rate adds no detail to the original.")</p>
            </div>
        </details>
        <button class="action convert-action" disabled="@(!ready || !jobs.Any(x => x.CanRetry) || QueueLocked)" @onclick="Convert">@(busy ? T("Procesando en tu dispositivo…", "Processing on your device…") : jobs.Count > 1 ? T("Convertir archivos a WAV", "Convert files to WAV") : SingleRetry ? T("Reintentar este archivo", "Retry this file") : T("Convertir a WAV", "Convert to WAV"))</button>
        }
        @if (busy) {
            <progress value="@fraction" max="1" aria-label="@T("Progreso de conversión", "Conversion progress")"></progress>
            <button class="secondary" @onclick="Cancel">@(jobs.Count > 1 ? T("Detener cola", "Stop queue") : T("Cancelar", "Cancel"))</button>
        }
        <p class="message" role="status">@if (DownloadBusy || finalizing) { <span class="spinner" aria-hidden="true"></span> }@Message</p>
        @if (jobs.Count > 1 && ReadyCount > 0) {
            <div class="batch-downloadbar">
                <button class="action download-all" disabled="@(QueueLocked)" aria-busy="@(preparingArchive ? "true" : "false")" @onclick="DownloadAll">
                    @if (preparingArchive) { <span class="spinner" aria-hidden="true"></span> }
                    else { <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M4 4h16v5H4zM6 9v11h12V9M10 13h4" /></svg> }
                    @(preparingArchive ? T("Generando ZIP…", "Creating ZIP…") : T($"Descargar todos ({ReadyCount})", $"Download all ({ReadyCount})"))
                </button>
                <small>@T("Archivos listos · WAV + mapas de canales", "Ready files · WAV + channel maps") @if (archiveBytes is long bytes) { <span class="archive-size" data-bytes="@bytes">· @FileSize.Display(bytes)</span> }</small>
                @if (preparingArchive) {
                    <progress value="@archiveFraction" max="1" aria-label="@T("Progreso del ZIP", "ZIP progress")"></progress>
                    <button class="secondary cancel-archive" @onclick="CancelArchive">@T("Cancelar ZIP", "Cancel ZIP")</button>
                }
            </div>
        }
        @if (SingleReady) { <ConversionResult Job="jobs[0]" Language="@language" Preparing="@(preparingJobId == jobs[0].Id)" DownloadBusy="UiLocked" Download="Download" DownloadMap="DownloadLayout" /> }
        <PreferencesPanel Notice="notice" Persistent="rememberedSettings" Language="@language" />
        <p class="privacy">@T("Procesamiento local. Sin subidas ni cuentas.", "Local processing. No uploads or accounts.")</p>
    </section>
    <p class="version-note">@T("Una herramienta pequeña para un sonido más amplio.", "A small tool for a wider sound.") <span>@T("Versión experimental.", "Experimental version.")</span></p>
    <div class="notes">
        <details><summary>@T("¿Qué contiene el WAV 9.1.6?", "What is in a 9.1.6 WAV?")</summary><p>@T("Un render de altavoces: nueve canales a nivel del oído, un LFE y seis superiores. El WAV final no conserva los objetos de audio editables.", "A speaker render: nine ear-level channels, one LFE and six overheads. The final WAV does not retain editable audio objects.")</p><p>@T("Orden", "Order"): L, R, C, LFE, Lrs, Rrs, Ls, Rs, Lw, Rw, Ltf, Rtf, Ltm, Rtm, Ltr, Rtr. @T("Descarga el mapa JSON para asignarlos en tu DAW. La máscara de altavoces del WAV queda sin especificar porque esta distribución no tiene una máscara estándar.", "Download the JSON map to assign them in your DAW. The WAV speaker mask is left unspecified because this layout has no standard mask.")</p></details>
        <details><summary>@T("Compatibilidad y procesamiento local", "Compatibility and local processing")</summary><p>@T("Admite E-AC-3 con objetos JOC a 48 kHz y sin DRM. Necesita un navegador moderno, espacio de almacenamiento y la pestaña abierta. Los archivos largos pueden tardar en móviles. La primera visita descarga el motor; el audio permanece en tu dispositivo.", "Supports E-AC-3 with JOC objects at 48 kHz, without DRM. Requires a modern browser, free storage and an open tab. Long files may take time on mobile. The first visit downloads the engine; your audio stays on your device.")</p><p>@T("Motor", "Engine"): <a href="https://github.com/VoidXH/Cavern">Cavern</a>, @T("de", "by") <a href="https://en.sbence.hu">Bence Sgánetz</a>. @T("El renderizado puede diferir del de otros motores. La detección inicial de JOC no garantiza que todos los fotogramas se decodifiquen correctamente. Revisa el resultado antes de utilizarlo.", "Rendering may differ from other engines. Initial JOC detection does not guarantee correct decoding of every frame. Check the result before using it.") <a href="CAVERN-LICENSE.md">@T("Licencia del motor", "Engine license")</a>.</p></details>
    </div>
</main>
<footer><span>@T("Hecho para escuchar con más espacio.", "More room for your sound.")</span><span>@T("Gratuito y sin anuncios · Proyecto independiente", "Free and ad-free · Independent project")</span></footer>

@code {
    const long MaxInput = 128L * 1024 * 1024;
    readonly List<ConversionJob> jobs = new();
    DotNetObjectReference<App>? bridge;
    bool ready, busy, finalizing, preparingArchive, editingQueue;
    double archiveFraction;
    long? archiveBytes;
    bool rememberedSettings = true;
    NoticeState notice = new();
    int ReadyCount => jobs.Count(x => x.State == JobState.Ready);
    string? preparingJobId;
    bool UiLocked => DownloadBusy || editingQueue;
    bool QueueLocked => busy || UiLocked;
    bool DownloadBusy => preparingJobId is not null || preparingArchive;
    bool SingleRetry => jobs.Count == 1 && jobs[0].CanRetry && (jobs[0].State is JobState.Failed or JobState.Cancelled);
    bool SingleReady => jobs.Count == 1 && jobs[0].State == JobState.Ready;
    bool AllReady => jobs.Count > 0 && jobs.All(x => x.State == JobState.Ready);
    double fraction;
    int bitDepth = 32, outputRate = 48000;
    string Format(ExportSettings settings) => $"{settings.SampleRate / 1000d:0.###} kHz · {settings.BitDepth}-bit {(settings.BitDepth == 32 ? "float" : "PCM")}";
    string language = "es", messageKey = "";
    CancellationTokenSource? cancellation;
    string? activeJobId;

    string T(string es, string en) => language == "en" ? en : es;
    string Message => messageKey == "batchDone" ? T("Cola terminada. Descarga los archivos listos; puedes volver a intentar los que fallaron.", "Queue finished. Download ready files; you can retry any that failed.") : ErrorMessage(messageKey);
    string ErrorMessage(string key) => key switch {
        "browser" => T("Este navegador no ofrece el almacenamiento local necesario. Prueba una versión actual de Chrome, Edge, Firefox o Safari mediante HTTPS.", "This browser does not offer the required local storage. Try a current version of Chrome, Edge, Firefox or Safari over HTTPS."),
        "queueLimit" => T("La cola admite hasta 20 archivos. Quita alguno para añadir más.", "The queue holds up to 20 files. Remove a file to add more."),
        "extension" => T("Selecciona un archivo EC3, EAC3, M4A o MP4.", "Choose an EC3, EAC3, M4A or MP4 file."),
        "size" => T("El límite de esta primera versión es 128 MiB.", "The input limit for this first version is 128 MiB."),
        "selected" => T("Se verificará el contenido JOC al convertir; la extensión no confirma el formato.", "JOC content will be checked during conversion; a file extension does not confirm the format."),
        "startingWorker" => T("Preparando el motor de conversión…", "Preparing the conversion engine…"),
        "workerError" => T("No se pudo iniciar el motor en segundo plano. Prueba una versión actual de Chrome, Edge, Firefox o Safari y vuelve a intentarlo.", "The background engine could not start. Try a current version of Chrome, Edge, Firefox or Safari and retry."),
        "sourceError" => T("No se pudo leer el archivo local. Quita esta entrada y selecciónalo de nuevo.", "The local file could not be read. Remove this entry and select it again."),
        "reading" => T("Leyendo el archivo local…", "Reading your local file…"),
        "rendering" => T("Decodificando objetos y renderizando 16 altavoces…", "Decoding objects and rendering 16 speakers…"),
        "done" => T("Conversión completada.", "Conversion complete."),
        "finalizing" => T("Generando tu archivo WAV…", "Generating your WAV file…"),
        "preparingArchive" => T("Generando el ZIP con tus archivos listos…", "Creating a ZIP with your ready files…"),
        "archiveSent" => T("Descarga del ZIP iniciada.", "ZIP download started."),
        "archiveCancelled" => T("Generación del ZIP cancelada. Tus WAV siguen disponibles.", "ZIP creation cancelled. Your WAVs are still available."),
        "archiveError" => T("No se pudo generar el ZIP. Comprueba el espacio libre; tus WAV siguen disponibles para descargarlos por separado.", "The ZIP could not be created. Check free storage; your WAVs are still available to download individually."),
        "preparingDownload" => T("Preparando el archivo para descargar…", "Preparing your file for download…"),
        "downloadSent" => T("Descarga iniciada.", "Download started."),
        "downloadError" => T("No se pudo iniciar la descarga. Inténtalo de nuevo; tu WAV sigue disponible.", "The download could not be requested. Try again; your WAV is still available."),
        "cancelled" => T("Conversión cancelada. Se eliminó la salida parcial.", "Conversion cancelled. The partial output was deleted."),
        "deleted" => T("Salida local eliminada.", "Local output deleted."),
        "missingJoc" => T("No se pudo convertir: no se detectaron objetos JOC compatibles. No se genera un falso 9.1.6 mediante upmix.", "Unable to convert: no compatible JOC objects were detected. This tool does not create a false 9.1.6 upmix."),
        "sampleRate" => T("No se pudo convertir: esta versión requiere una fuente de 48 kHz.", "Unable to convert: this version requires a 48 kHz source."),
        "riffLimit" => T("No se pudo convertir: la salida excede el límite WAV de 4 GiB. RF64 aún no está implementado.", "Unable to convert: the output exceeds the 4 GiB WAV limit. RF64 is not implemented yet."),
        "integerRange" => T("La señal supera el rango de 16 bits. Elige 32-bit float para conservarla sin recortes.", "The signal exceeds the 16-bit range. Choose 32-bit float to preserve it without clipping."),
        "outputSettings" => T("Selecciona una profundidad de bits y frecuencia compatibles.", "Select a supported bit depth and sample rate."),
        "invalidPcm" => T("No se pudo convertir: el motor produjo muestras de audio no válidas.", "Unable to convert: the engine produced invalid audio samples."),
        "storageError" => T("No se pudo convertir: no se pudo escribir la salida local. Comprueba el espacio disponible y los permisos del navegador.", "Unable to convert: local output could not be written. Check free storage and browser permissions."),
        "decodeError" => T("No se pudo convertir: no se pudo interpretar este archivo. Comprueba que contiene E-AC-3/JOC compatible y que no está protegido.", "Unable to convert: this file could not be decoded. Check that it contains supported, unprotected E-AC-3/JOC."),
        _ => ""
    };

    protected override async Task OnAfterRenderAsync(bool firstRender) {
        if (!firstRender) return;
        try {
            language = await JS.InvokeAsync<string>("spatialI18n.get");
            bridge = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("spatial.attachPicker", bridge);
            ready = await JS.InvokeAsync<bool>("spatial.supported");
            if (!ready) messageKey = "browser";
        } catch (Exception e) { Console.WriteLine(e); messageKey = "browser"; }
        try {
            var saved = await JS.InvokeAsync<SitePreferences>("spatialPreferences.load", bridge);
            var settings = new ExportSettings(saved.BitDepth, saved.SampleRate); settings.Validate();
            bitDepth = settings.BitDepth; outputRate = settings.SampleRate;
            rememberedSettings = saved.Persistent; notice = saved.Notice;
        } catch (Exception e) { Console.WriteLine(e); rememberedSettings = false; }
        StateHasChanged();
    }

    async Task SaveExportSettings() {
        try { rememberedSettings = await JS.InvokeAsync<bool>("spatialPreferences.saveExport", bitDepth, outputRate); }
        catch (Exception e) { Console.WriteLine(e); rememberedSettings = false; }
    }
    [JSInvokable]
    public void NoticeChanged(NoticeState value) { notice = value; StateHasChanged(); }
    async Task Activity(string kind, bool active) {
        try { await JS.InvokeVoidAsync("spatialPreferences.setActivity", kind, active); }
        catch (Exception e) { Console.WriteLine(e); }
    }
    object[] ReadyPayload() => jobs.Where(x => x.State == JobState.Ready).Select(x => new { id = x.Id, name = x.OutputName, sampleRate = x.Settings.SampleRate, bitDepth = x.Settings.BitDepth, size = x.OutputBytes }).ToArray();
    async Task RefreshArchiveSize() {
        archiveBytes = null;
        if (jobs.Count < 2 || ReadyCount == 0) return;
        try { archiveBytes = await JS.InvokeAsync<long>("spatial.archiveSize", ReadyPayload(), Converter.ChannelOrder); }
        catch (Exception e) { Console.WriteLine(e); }
    }
    async Task NotifyCompletion(IEnumerable<ConversionJob> completed) {
        try { await JS.InvokeVoidAsync("spatialPreferences.complete", language, completed.Count(x => x.State == JobState.Ready), completed.Count(x => x.State == JobState.Failed)); }
        catch (Exception e) { Console.WriteLine(e); }
    }

    Task UseSpanish() => SetLanguage("es");
    Task UseEnglish() => SetLanguage("en");
    async Task SetLanguage(string value) {
        language = value;
        await JS.InvokeVoidAsync("spatialI18n.set", value);
    }

    [JSInvokable]
    public async Task ReceiveFiles(SelectedAudio[] files) {
        if (QueueLocked || !ready) {
            foreach (var file in files) await JS.InvokeVoidAsync("spatial.releaseFile", file.Id);
            return;
        }
        bool overflow = false;
        foreach (var file in files) {
            if (jobs.Count >= 20) { overflow = true; await JS.InvokeVoidAsync("spatial.releaseFile", file.Id); continue; }
            var job = new ConversionJob(file);
            if (!new[] { ".ec3", ".eac3", ".m4a", ".mp4" }.Contains(Path.GetExtension(file.Name).ToLowerInvariant())) job.Error = "extension";
            else if (file.Size > MaxInput) job.Error = "size";
            if (job.Error != "") { job.State = JobState.Failed; await JS.InvokeVoidAsync("spatial.releaseFile", file.Id); }
            jobs.Add(job);
        }
        await RefreshArchiveSize();
        messageKey = overflow ? "queueLimit" : jobs.Count == 1 && jobs[0].Error != "" ? jobs[0].Error : "selected";
        StateHasChanged();
    }

    string JobStatus(ConversionJob job) => job.State switch {
        JobState.Pending => T("En espera", "Queued"), JobState.Reading => T("Leyendo…", "Reading…"),
        JobState.Rendering => T("Convirtiendo…", "Converting…"), JobState.Finalizing => T("Generando WAV…", "Generating WAV…"),
        JobState.Ready => T("Listo para descargar", "Ready to download"), JobState.Failed => T("No se pudo convertir", "Conversion failed"),
        _ => T("Cancelado", "Cancelled")
    };

    async Task PickFiles() => await JS.InvokeVoidAsync("spatial.pickFiles");
    async Task Remove(ConversionJob job) {
        if (QueueLocked) return;
        editingQueue = true; StateHasChanged();
        try {
            await JS.InvokeVoidAsync("spatial.discard", job.Id);
            await JS.InvokeVoidAsync("spatial.releaseFile", job.Id);
            jobs.Remove(job); messageKey = "";
            await RefreshArchiveSize();
        } finally { editingQueue = false; }
    }

    Task Convert() => RunJobs(jobs.Where(x => x.CanRetry).ToArray(), true);
    Task Retry(ConversionJob job) => RunJobs(job.CanRetry && (job.State is JobState.Failed or JobState.Cancelled) ? new[] { job } : Array.Empty<ConversionJob>(), false);

    async Task RunJobs(ConversionJob[] pending, bool wholeQueue) {
        if (QueueLocked || pending.Length == 0) return;
        busy = true; fraction = 0; cancellation = new();
        var export = new ExportSettings(bitDepth, outputRate);
        try {
            await Activity("conversion", true);
            foreach (var job in pending) {
                if (cancellation.IsCancellationRequested) break;
                activeJobId = job.Id; job.OutputBytes = 0; job.Error = ""; job.State = JobState.Reading; fraction = 0; messageKey = "reading"; StateHasChanged();
                try {
                    await JS.InvokeVoidAsync("spatial.begin", job.Id);
                    cancellation.Token.ThrowIfCancellationRequested();
                    // The File is cloned to a dedicated worker. Audio and OPFS writes
                    // never cross or await the main/UI thread.
                    string code = await JS.InvokeAsync<string>("spatial.convert", job.Id, export.BitDepth, export.SampleRate);
                    if (code == "cancelled") throw new OperationCanceledException(cancellation.Token);
                    if (code != "") throw new ConversionException(code);
                    cancellation.Token.ThrowIfCancellationRequested();
                    finalizing = true; job.State = JobState.Finalizing; messageKey = "finalizing"; StateHasChanged();
                    job.OutputBytes = await JS.InvokeAsync<long>("spatial.finish");
                    cancellation.Token.ThrowIfCancellationRequested();
                    job.Settings = export; job.State = JobState.Ready; messageKey = "done";
                    await JS.InvokeVoidAsync("spatial.releaseFile", job.Id);
                    await RefreshArchiveSize();
                } catch (OperationCanceledException) {
                    await JS.InvokeVoidAsync("spatial.discard", job.Id);
                    job.State = JobState.Cancelled; messageKey = "cancelled";
                    break;
                } catch (Exception e) {
                    Console.WriteLine(e);
                    await JS.InvokeVoidAsync("spatial.discard", job.Id);
                    job.Error = e is ConversionException conversion ? conversion.Code : e is JSException ? "storageError" : "decodeError";
                    job.State = JobState.Failed; messageKey = job.Error;
                } finally { finalizing = false; StateHasChanged(); }
                await JS.InvokeVoidAsync("spatial.cooperate");
            }
            if (pending.Length > 1 && !cancellation.IsCancellationRequested) messageKey = "batchDone";
            if (!cancellation.IsCancellationRequested) await NotifyCompletion(wholeQueue ? jobs : pending);
        } finally {
            busy = false; activeJobId = null; cancellation.Dispose(); cancellation = null;
            await Activity("conversion", false);
        }
    }

    [JSInvokable]
    public void ConversionProgress(string id, string stage, double value) {
        if (!busy || activeJobId != id || cancellation?.IsCancellationRequested == true) return;
        var job = jobs.FirstOrDefault(x => x.Id == id);
        if (job is null || job.State is JobState.Ready or JobState.Failed or JobState.Cancelled) return;
        job.State = stage == "finalizing" ? JobState.Finalizing : stage == "rendering" ? JobState.Rendering : JobState.Reading;
        finalizing = stage == "finalizing"; fraction = Math.Clamp(value, 0, 1); messageKey = stage;
        StateHasChanged();
    }
    async Task Cancel() {
        cancellation?.Cancel();
        await JS.InvokeVoidAsync("spatial.cancelConversion");
    }
    async Task NewConversion() {
        if (QueueLocked) return;
        editingQueue = true; StateHasChanged();
        try {
            await JS.InvokeVoidAsync("spatial.discard");
            await JS.InvokeVoidAsync("spatial.clearFiles");
            jobs.Clear(); fraction = 0; messageKey = ""; archiveBytes = null;
        } finally { editingQueue = false; }
    }

    async Task Download(ConversionJob job) {
        if (UiLocked) return;
        preparingJobId = job.Id; messageKey = "preparingDownload"; StateHasChanged();
        try {
            await JS.InvokeVoidAsync("spatial.download", job.OutputName, job.Id);
            job.DownloadRequested = true; messageKey = "downloadSent";
        } catch (Exception e) { Console.WriteLine(e); messageKey = "downloadError"; }
        finally { preparingJobId = null; }
    }
    [JSInvokable]
    public void ArchiveProgress(double value) {
        if (!preparingArchive) return;
        archiveFraction = Math.Clamp(value, 0, 1); StateHasChanged();
    }
    async Task DownloadAll() {
        if (QueueLocked || ReadyCount == 0) return;
        preparingArchive = true; archiveFraction = 0; messageKey = "preparingArchive"; StateHasChanged();
        var readyJobs = ReadyPayload();
        try {
            await Activity("archive", true);
            bool sent = await JS.InvokeAsync<bool>("spatial.downloadAll", readyJobs, Converter.ChannelOrder);
            messageKey = sent ? "archiveSent" : "archiveCancelled";
        } catch (Exception e) { Console.WriteLine(e); messageKey = "archiveError"; }
        finally { preparingArchive = false; await Activity("archive", false); }
    }
    async Task CancelArchive() => await JS.InvokeVoidAsync("spatial.cancelArchive");
    async Task DownloadLayout(ConversionJob job) => await JS.InvokeVoidAsync("spatial.layout", job.OutputName, Converter.ChannelOrder, job.Settings.SampleRate, job.Settings.BitDepth, job.Id);
    public void Dispose() { cancellation?.Cancel(); bridge?.Dispose(); }
}
